# ── LLM ──────────────────────────────────────────────────────────────────
# Required. Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for RAG answers (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Application ───────────────────────────────────────────────────────────
APP_TITLE=Insurance Claim Decision Assistant
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── File Storage ──────────────────────────────────────────────────────────
# Directory where uploaded policy PDFs are saved
UPLOAD_DIR=./uploads

# Directory where ChromaDB persists vector data
# Note: the app currently uses EphemeralClient (in-memory), so this path
# is used only for directory creation on startup.
CHROMA_PERSIST_DIR=./chroma_db

# ── RAG / Chunking ────────────────────────────────────────────────────────
# Number of policy chunks retrieved per question
RAG_TOP_K=3

# PDF text splitter settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
